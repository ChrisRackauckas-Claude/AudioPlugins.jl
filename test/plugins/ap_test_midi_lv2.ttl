# Port descriptions of the MIDI test plugin in ap_test_midi_lv2.c. The
# bundle's manifest.ttl is written by lv2_midi_test_bundle() at build
# time, because it must name the binary with the platform's extension.
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix atom:  <http://lv2plug.in/ns/ext/atom#> .
@prefix midi:  <http://lv2plug.in/ns/ext/midi#> .
@prefix patch: <http://lv2plug.in/ns/ext/patch#> .
@prefix rsz:   <http://lv2plug.in/ns/ext/resize-port#> .
@prefix urid:  <http://lv2plug.in/ns/ext/urid#> .

<urn:audioplugins:test:notegain>
    a lv2:Plugin, lv2:AmplifierPlugin ;
    doap:name "AudioPlugins Test Note-Gated Gain" ;
    lv2:optionalFeature lv2:hardRTCapable ;
    lv2:requiredFeature urid:map ;
    lv2:port [
        a lv2:InputPort, atom:AtomPort ;
        lv2:index 0 ; lv2:symbol "patch_in" ; lv2:name "Patch In" ;
        lv2:portProperty lv2:connectionOptional ;
        atom:bufferType atom:Sequence ;
        atom:supports patch:Message
    ] , [
        a lv2:InputPort, atom:AtomPort ;
        lv2:index 1 ; lv2:symbol "midi_in" ; lv2:name "MIDI In" ;
        atom:bufferType atom:Sequence ;
        atom:supports midi:MidiEvent ;
        rsz:minimumSize 16384
    ] , [
        a lv2:OutputPort, atom:AtomPort ;
        lv2:index 2 ; lv2:symbol "midi_out" ; lv2:name "MIDI Out" ;
        atom:bufferType atom:Sequence ;
        atom:supports midi:MidiEvent
    ] , [
        a lv2:InputPort, lv2:AudioPort ;
        lv2:index 3 ; lv2:symbol "in" ; lv2:name "In"
    ] , [
        a lv2:OutputPort, lv2:AudioPort ;
        lv2:index 4 ; lv2:symbol "out" ; lv2:name "Out"
    ] , [
        a lv2:OutputPort, lv2:ControlPort ;
        lv2:index 5 ; lv2:symbol "n_echo" ; lv2:name "Events Echoed" ;
        lv2:minimum 0.0 ; lv2:maximum 1024.0
    ] .
